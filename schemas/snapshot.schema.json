{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/RyanLin-InfEvo/hyperpod-analytics/main/schemas/snapshot.schema.json",
  "title": "HyperPod Snapshot (Daily, Monthly, Latest)",
  "description": "Keyframe + change-log position snapshots and columnar time series for snapshots/days/*.json, snapshots/months/*.json.gz, and snapshots/latest.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "coins",
    "tracked",
    "keyframe",
    "posChanges",
    "series"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "coins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reconstructed": {
      "type": "boolean"
    },
    "reconstructedBefore": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "markResolution": {
      "type": ["string", "null"],
      "enum": ["5m", "10m", "1h", "4h", "mixed", null]
    },
    "tracked": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": ["integer", "null"],
            "minimum": 0
          }
        ],
        "minItems": 3,
        "maxItems": 3,
        "items": false
      }
    },
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "pos"],
      "properties": {
        "t": {
          "type": "integer",
          "minimum": 0
        },
        "pos": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "number",
                "not": {
                  "const": 0
                }
              },
              {
                "type": ["number", "null"],
                "exclusiveMinimum": 0
              }
            ],
            "minItems": 4,
            "maxItems": 4,
            "items": false
          }
        }
      }
    },
    "posChanges": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "number"
          },
          {
            "type": ["number", "null"],
            "exclusiveMinimum": 0
          }
        ],
        "minItems": 5,
        "maxItems": 5,
        "items": false,
        "not": {
          "prefixItems": [
            {},
            {},
            {},
            {
              "const": 0
            },
            {
              "not": {
                "type": "null"
              }
            }
          ]
        }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "mark", "av"],
      "properties": {
        "t": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "mark": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": ["number", "null"],
              "exclusiveMinimum": 0
            }
          }
        },
        "av": {
          "type": "object",
          "additionalProperties": false,
          "required": ["addrIds", "values"],
          "properties": {
            "addrIds": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "values": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": ["number", "null"]
                }
              }
            }
          }
        }
      }
    },
    "stale": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "minItems": 2,
        "maxItems": 2,
        "items": false
      }
    }
  }
}
